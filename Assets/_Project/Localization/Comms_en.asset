  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Comms_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 589d40514a6cca14ba52d5bc263a867b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 762306560
    m_Localized: H.E.L.M.
    m_Metadata:
      m_Items: []
  - m_Id: 804249600
    m_Localized: BATHY
    m_Metadata:
      m_Items: []
  - m_Id: 804249601
    m_Localized: Comms link online. Helmet systems nominal.
    m_Metadata:
      m_Items: []
  - m_Id: 16934954328064
    m_Localized: 'Suit integrity: 61%. Primary systems offline.'
    m_Metadata:
      m_Items: []
  - m_Id: 16935373758464
    m_Localized: Emergency mode active. Technically, you are still operational.
    m_Metadata:
      m_Items: []
  - m_Id: 16935675748352
    m_Localized: 'Depth: 2000 m. We landed several kilometers off the designated
      dock.'
    m_Metadata:
      m_Items: []
  - m_Id: 16935977738240
    m_Localized: 'This area is an abandoned company complex. Environment: hostile.'
    m_Metadata:
      m_Items: []
  - m_Id: 16936309088256
    m_Localized: 'Oxygen replenished. Survival probability: 0.002%. It doubled.'
    m_Metadata:
      m_Items: []
  - m_Id: 16936615272448
    m_Localized: 'Oxygen reserve is limited. Nearest company structure: a lock gate.
      South, down the canyon.'
    m_Metadata:
      m_Items: []
  - m_Id: 16936921456640
    m_Localized: Suit lights online. Fauna ahead. At this depth, light gets noticed.
    m_Metadata:
      m_Items: []
  - m_Id: 16937194086400
    m_Localized: Watch how they react to your light. Then decide how bright you want
      to be.
    m_Metadata:
      m_Items: []
  - m_Id: 16937483493376
    m_Localized: Oxygen station detected. No power.
    m_Metadata:
      m_Items: []
  - m_Id: 16937764511744
    m_Localized: Company stations run on standard energy cells. Find one. Plug it
      in.
    m_Metadata:
      m_Items: []
  - m_Id: 16938045530112
    m_Localized: Red light module installed. Most local fauna cannot see red.
    m_Metadata:
      m_Items: []
  - m_Id: 16938330742784
    m_Localized: Most.
    m_Metadata:
      m_Items: []
  - m_Id: 50911912124416
    m_Localized: Fauna protocol.
    m_Metadata:
      m_Items: []
  - m_Id: 50911954067456
    m_Localized: 'Thaladyne reminds you: the fauna is not company property. You are.'
    m_Metadata:
      m_Items: []
  - m_Id: 50911954067457
    m_Localized: Drop the cell. Hold still.
    m_Metadata:
      m_Items: []
  - m_Id: 134047027159040
    m_Localized: H.E.L.M. online. Hazard and Environment Linked Monitor. Your suit
      assistant.
    m_Metadata:
      m_Items: []
  - m_Id: 134047069102080
    m_Localized: Nuclear energy cell. It flares when it moves. Carry it gently.
    m_Metadata:
      m_Items: []
  - m_Id: 134047069102081
    m_Localized: It is also radioactive. Do not sleep next to it.
    m_Metadata:
      m_Items: []
  - m_Id: 134047069102082
    m_Localized: Power restored. Stand close to the station to refill your oxygen.
    m_Metadata:
      m_Items: []
  - m_Id: 134047069102083
    m_Localized: The gate has an optical sensor. It is waiting for a specific light.
    m_Metadata:
      m_Items: []
  - m_Id: 134047069102084
    m_Localized: 'Optical sensor: accepted. Lock gate opening.'
    m_Metadata:
      m_Items: []
  - m_Id: 329795454885888
    m_Localized: The hatch is jammed. Use the emergency release, on your right.
    m_Metadata:
      m_Items: []
  - m_Id: 329796419575808
    m_Localized: Emergency release, on your right. Grab it and pull it up.
    m_Metadata:
      m_Items: []
  - m_Id: 358456761507840
    m_Localized: Red light module. Compatible with your suit lamp. Install it.
    m_Metadata:
      m_Items: []
  - m_Id: 361536873816064
    m_Localized: Light source nearby. It looks like a Thaladyne device.
    m_Metadata:
      m_Items: []
  - m_Id: 361537242914816
    m_Localized: Optical sensor, red spectrum. Switch to red light, and aim it at
      the sensor.
    m_Metadata:
      m_Items: []
  - m_Id: 365289916063744
    m_Localized: Oxygen at fifty percent.
    m_Metadata:
      m_Items: []
  - m_Id: 365290222247936
    m_Localized: Oxygen at twenty-five percent. Locate a refill station.
    m_Metadata:
      m_Items: []
  - m_Id: 365290469711872
    m_Localized: Thirty seconds of oxygen remaining.
    m_Metadata:
      m_Items: []
  - m_Id: 365290725564416
    m_Localized: Warning. Oxygen critical. Ten seconds.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
