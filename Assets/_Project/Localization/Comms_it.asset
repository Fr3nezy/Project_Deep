  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Comms_it
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 589d40514a6cca14ba52d5bc263a867b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 762306560
    m_Localized: H.E.L.M.
    m_Metadata:
      m_Items: []
  - m_Id: 804249600
    m_Localized: BATHY
    m_Metadata:
      m_Items: []
  - m_Id: 804249601
    m_Localized: Collegamento attivo. Sistemi del casco nella norma.
    m_Metadata:
      m_Items: []
  - m_Id: 16934954328064
    m_Localized: "Integrit\xE0 dello scafandro: 61%. Sistemi primari non disponibili."
    m_Metadata:
      m_Items: []
  - m_Id: 16935373758464
    m_Localized: "Modalit\xE0 di emergenza attiva. Tecnicamente sei ancora operativo."
    m_Metadata:
      m_Items: []
  - m_Id: 16935675748352
    m_Localized: "Profondit\xE0: 2000 m. Siamo atterrati a diversi chilometri dall'attracco
      designato."
    m_Metadata:
      m_Items: []
  - m_Id: 16935977738240
    m_Localized: "La zona \xE8 un vecchio complesso abbandonato della compagnia.
      Ambiente: ostile."
    m_Metadata:
      m_Items: []
  - m_Id: 16936309088256
    m_Localized: "Ossigeno ricaricato. Probabilit\xE0 di sopravvivenza: 0,002%. \xC8
      raddoppiata."
    m_Metadata:
      m_Items: []
  - m_Id: 16936615272448
    m_Localized: "Riserva di ossigeno limitata. Struttura della compagnia pi\xF9
      vicina: una chiusa. A sud, in fondo al canyon."
    m_Metadata:
      m_Items: []
  - m_Id: 16936921456640
    m_Localized: "Luci della tuta attive. Fauna in vista. A questa profondit\xE0,
      la luce si fa notare."
    m_Metadata:
      m_Items: []
  - m_Id: 16937194086400
    m_Localized: Guarda come reagiscono alla tua luce. Poi decidi quanto vuoi farti
      vedere.
    m_Metadata:
      m_Items: []
  - m_Id: 16937483493376
    m_Localized: Stazione di ossigeno rilevata. Nessuna alimentazione.
    m_Metadata:
      m_Items: []
  - m_Id: 16937764511744
    m_Localized: Le stazioni della compagnia vanno a celle di energia standard. Trovane
      una. Inseriscila.
    m_Metadata:
      m_Items: []
  - m_Id: 16938045530112
    m_Localized: Modulo luce rossa installato. Quasi tutta la fauna locale non vede
      il rosso.
    m_Metadata:
      m_Items: []
  - m_Id: 16938330742784
    m_Localized: Quasi.
    m_Metadata:
      m_Items: []
  - m_Id: 50911912124416
    m_Localized: Protocollo fauna.
    m_Metadata:
      m_Items: []
  - m_Id: 50911954067456
    m_Localized: "La Thaladyne ricorda: la fauna non \xE8 propriet\xE0 aziendale.
      Tu s\xEC."
    m_Metadata:
      m_Items: []
  - m_Id: 50911954067457
    m_Localized: Molla la cella. Resta fermo.
    m_Metadata:
      m_Items: []
  - m_Id: 134047027159040
    m_Localized: H.E.L.M. attivo. Hazard and Environment Linked Monitor. Assistente
      dello scafandro.
    m_Metadata:
      m_Items: []
  - m_Id: 134047069102080
    m_Localized: Cella di energia nucleare. Si illumina quando si muove. Maneggiala
      con cura.
    m_Metadata:
      m_Items: []
  - m_Id: 134047069102081
    m_Localized: "\xC8 anche radioattiva. Non dormirci accanto."
    m_Metadata:
      m_Items: []
  - m_Id: 134047069102082
    m_Localized: Energia ripristinata. Resta vicino alla stazione per ricaricare
      l'ossigeno.
    m_Metadata:
      m_Items: []
  - m_Id: 134047069102083
    m_Localized: Il gate ha un sensore ottico. Aspetta un tipo di luce preciso.
    m_Metadata:
      m_Items: []
  - m_Id: 134047069102084
    m_Localized: 'Sensore ottico: accettato. Apertura della chiusa.'
    m_Metadata:
      m_Items: []
  - m_Id: 329795454885888
    m_Localized: "Il portello \xE8 bloccato. Usa lo sblocco di emergenza, alla tua
      destra."
    m_Metadata:
      m_Items: []
  - m_Id: 329796419575808
    m_Localized: Sblocco di emergenza, alla tua destra. Afferralo e tiralo su.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
