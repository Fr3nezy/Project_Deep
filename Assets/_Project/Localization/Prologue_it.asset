  m_TableData:
  - m_Id: 1135599616
    m_Localized: Apri Portello
    m_Metadata:
      m_Items: []
  - m_Id: 1177542656
    m_Localized: B.A.T.H.Y.
    m_Metadata:
      m_Items: []
  - m_Id: 1181736960
    m_Localized: Sistemi avviati. Discesa verso Fossa di Cayman.
    m_Metadata:
      m_Items: []
  - m_Id: 1181736961
    m_Localized: Rilevata perturbazione idrodinamica minore.
    m_Metadata:
      m_Items: []
  - m_Id: 1181736962
    m_Localized: 'Allarme: impatti multipli sullo scafo esterno!'
    m_Metadata:
      m_Items: []
  - m_Id: 1181736963
    m_Localized: "Integrit\xE0 cavo primario compromessa. Tensione critica."
    m_Metadata:
      m_Items: []
  - m_Id: 1181736964
    m_Localized: Rottura cavo secondario. Cedimento strutturale.
    m_Metadata:
      m_Items: []
  - m_Id: 1181736965
    m_Localized: Frenata d'emergenza... impatto imminente!
    m_Metadata:
      m_Items: []
  - m_Id: 1181736966
    m_Localized: "Riavvio di emergenza... Profondit\xE0 8.420m. Integrit\xE0 scafandro
      confermata."
    m_Metadata:
      m_Items: []
  references:
    version: 2
